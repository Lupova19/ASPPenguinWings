@model IEnumerable<ASPPenguinWings.Models.Product>

@{
    ViewData["Title"] = "Продукти";
}

<h2>Продукти</h2>

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="create-btn">+ Добави продукт</a>
}

<div class="products">
    @foreach (var item in Model)
    {
        <div class="card">

            <img src="@item.ImageUrl" alt="@item.Name" />

            <h4>@item.Name</h4>

            <p class="price">@item.Price лв.</p>

            <p>@item.Categories?.Name</p>

            <div class="actions">
                <a asp-action="Details" asp-route-id="@item.Id">Виж</a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактирай</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтрий</a>
                }
            </div>

        </div>
    }
</div>
