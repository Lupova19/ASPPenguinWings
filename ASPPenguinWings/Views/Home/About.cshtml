
@{
    ViewData["Title"] = "За нас";
}

<div class="modern-about-page">

    <section class="about-hero">

        <div class="about-hero-overlay">

            <span class="about-badge">
                🐾 Крилете на пингвина
            </span>

            <h1>
                Грижа за всеки любимец
            </h1>

            <p>
                Ние вярваме, че домашните любимци заслужават
                най-доброто – качествени продукти, грижа и любов.
            </p>

        </div>

    </section>

    <section class="about-content">

        <div class="about-modern-card">

            <div class="about-modern-image">
                <img src="/images/pet1.png" />
            </div>

            <div class="about-modern-text">

                <span>🐾 Нашата мисия</span>

                <h2>
                    Създадено с любов към животните
                </h2>

                <p>
                    Нашата цел е да предложим модерни,
                    качествени и достъпни продукти
                    за всеки домашен любимец.
                </p>

            </div>

        </div>

        <div class="about-modern-card reverse-card">

            <div class="about-modern-image">
                <img src="/images/zooshop.png" />
            </div>

            <div class="about-modern-text">

                <span>🚚 Бърза доставка</span>

                <h2>
                    Доставяме навсякъде
                </h2>

                <p>
                    Осигуряваме сигурна и бърза доставка,
                    за да получите всичко необходимо
                    за вашия любимец навреме.
                </p>

            </div>

        </div>

        <div class="about-modern-card">

            <div class="about-modern-image">
                <img src="/images/quality.png" />
            </div>

            <div class="about-modern-text">

                <span>💎 Качество</span>

                <h2>
                    Само проверени продукти
                </h2>

                <p>
                    Работим с висококачествени продукти,
                    които гарантират комфорт и грижа
                    за вашите домашни любимци.
                </p>

            </div>

        </div>

    </section>

    <section class="about-cta">

        <h2>
            Имате въпроси?
        </h2>

        <p>
            Свържете се с нас и ще ви помогнем.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="about-modern-btn">

            Свържи се с нас

        </a>

    </section>

</div>