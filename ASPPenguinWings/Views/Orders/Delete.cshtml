
@model ASPPenguinWings.Models.Order

@{
    ViewData["Title"] = "Изтриване на поръчка";
}

<div class="delete-order-page">

    <div class="delete-order-card">

        <div class="delete-order-image">

            <img src="@Model.Products.ImageUrl" alt="@Model.Products.Name" />

        </div>

        <div class="delete-order-info">

            <span class="order-warning">
                ⚠️ Внимание
            </span>

            <h1>Изтриване на поръчка</h1>

            <p class="order-delete-text">
                Сигурни ли сте, че искате да премахнете тази поръчка?
            </p>

            <div class="order-delete-details">

                <div class="order-detail-box">
                    <span>Продукт</span>
                    <strong>@Model.Products.Name</strong>
                </div>

                <div class="order-detail-box">
                    <span>Количество</span>
                    <strong>@Model.Quantity</strong>
                </div>

                <div class="order-detail-box">
                    <span>Цена</span>
                    <strong>@Model.Products.Price € </strong>
                </div>

                <div class="order-detail-box">
                    <span>Дата</span>
                    <strong>@Model.DateOn.ToShortDateString()</strong>
                </div>

            </div>

            
            <div class="order-total-price">
                Общо:
                <strong>
                    @(Model.Products.Price* Model.Quantity) лв.
                </strong>
            </div>

            <div class="order-delete-buttons">

                <form asp-action="Delete">

                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="delete-order-btn">
                        🗑️ Изтрий поръчката
                    </button>

                </form>

                <a asp-action="Index" class="back-order-btn">
                    ← Назад
                </a>

            </div>

        </div>

    </div>

</div>