<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASPPenguinWings</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASPPenguinWings.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/logopw.png" class="logo-img" />
                    Крилете на пингвина
                    </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Начало
                                
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" data-bs-toggle="dropdown">Храна за животни</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="6">Храна за котки</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="7">Храна за кучета</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="8">Храна за птици</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="9">Храна за риби</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" data-bs-toggle="dropdown">Аксесоари и играчки</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="10">Аксесоари и играчки за котки</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="11">Аксесоари и играчки за кучета</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="12">Аксесоари и играчки за птици</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="13">Аксесоари и играчки за риби</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" data-bs-toggle="dropdown">Акваристика</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="14">Аквариуми</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="15">Оборудване</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="ByCategory" asp-route-id="16">Декорации</a></li>
                            </ul>
                        </li>
                       

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Contact">Контакти</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="About">За нас</a>
                        </li>
                        <li class="nav-item">
                            @if (User.IsInRole("User"))
                            {
                                <a class="nav-link text-dark" asp-controller="Orders" asp-action="MyOrders">
                                    Моите поръчки
                                </a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Orders" asp-action="Index">
                                🛒
                            </a>
                        </li>
                    </ul>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3 container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-container">

            <div class="footer-section">
                <h3>Контакти</h3>
                <p>София, България</p>
                <p>+359 88 123 4567</p>
                <p>info@penguinwings.bg</p>
            </div>

            <div class="footer-section">
                <h3>Меню</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Начало</a></li>

                    <li><a asp-controller="Products" asp-action="ByCategory" asp-route-id="6">Храна за животни</a></li>
                    <li><a asp-controller="Products" asp-action="ByCategory" asp-route-id="7">Аксесоари и играчки</a></li>
                    <li><a asp-controller="Products" asp-action="ByCategory" asp-route-id="8">Акваристика</a></li>

                    <li><a asp-controller="Home" asp-action="Contact">Контакти</a></li>
                    <li><a asp-controller="Home" asp-action="About">За нас</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h3>Социални мрежи</h3>
                <div class="social-icons">
                    <a href="#"><img src="/images/facebook.png" /></a>
                    <a href="#"><img src="/images/instagram.png" /></a>
                    <a href="#"><img src="/images/tiktok.png" /></a>
                    <a href="#"><img src="/images/x.jpg" /></a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            &copy; 2026 Крилете на пингвина
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
