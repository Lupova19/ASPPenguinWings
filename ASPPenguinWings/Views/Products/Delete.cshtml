
@model ASPPenguinWings.Models.Product

@{
    ViewData["Title"] = "Изтриване";
}

<div class="delete-page">

    <div class="delete-card">

        <!-- IMAGE -->
        <div class="delete-image">
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        </div>

        <!-- INFO -->
        <div class="delete-info">

            <span class="delete-warning">
                ⚠️ Внимание
            </span>

            <h1>Изтриване на продукт</h1>

            <p class="delete-text">
                Сигурни ли сте, че искате да изтриете този продукт?
            </p>

            <div class="delete-details">

                <div class="delete-box">
                    <span>Име</span>
                    <strong>@Model.Name</strong>
                </div>

                <div class="delete-box">
                    <span>Категория</span>
                    <strong>@Model.Categories?.Name</strong>
                </div>

                <div class="delete-box">
                    <span>Цена</span>
                    <strong>@Model.Price лв.</strong>
                </div>

                <div class="delete-box">
                    <span>Количество</span>
                    <strong>@Model.Quantity</strong>
                </div>

            </div>

            <p class="delete-description">
                @Model.Description
            </p>

            <!-- BUTTONS -->
            <div class="delete-buttons">

                <form asp-action="Delete">

                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="delete-btn-modern">
                        🗑️ Изтрий продукта
                    </button>

                </form>

                <a asp-action="Index" class="cancel-btn-modern">
                    ← Назад
                </a>

            </div>

        </div>

    </div>

</div>