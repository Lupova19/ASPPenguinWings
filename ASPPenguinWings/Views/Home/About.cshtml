
@{
    ViewData["Title"] = "За нас";
}

<div class="about-simple">

    <h1>За нас</h1>

    <!-- Секция 1 -->
    <div class="about-row">
        <div class="about-text">
            <h2>🐾 Нашата мисия</h2>
            <p>
                Създадохме този магазин с една идея –
                да предложим качествени продукти за домашни любимци
                на достъпни цени.
            </p>
        </div>

        <div class="about-image">
            <img src="/images/pet1.png" />
        </div>
    </div>

    <!-- Секция 2 -->
    <div class="about-row reverse">
        <div class="about-text">
            <h2>🚚 Доставка</h2>
            <p>
                Осигуряваме бърза и сигурна доставка,
                за да достигнат продуктите до вас навреме.
            </p>
        </div>

        <div class="about-image">
            <img src="/images/zooshop.png" />
        </div>
    </div>

    <!-- Секция 3 -->
    <div class="about-row">
        <div class="about-text">
            <h2>💎 Качество</h2>
            <p>
                Работим само с проверени продукти,
                за да гарантираме най-доброто за вашите любимци.
            </p>
        </div>

        <div class="about-image">
            <img src="/images/quality.png" />
        </div>
    </div>

    <!-- Бутон -->
    <div class="about-bottom">
        <a asp-controller="Home" asp-action="Contact" class="about-btn">
            Свържи се с нас
        </a>
    </div>

</div>