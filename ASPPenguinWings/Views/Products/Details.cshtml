
@model ASPPenguinWings.Models.Product

@{
    ViewData["Title"] = "Детайли за продукт";
}

<div class="details-page">

    <div class="details-card">

        <div class="details-image">

            <img src="@Model.ImageUrl" alt="@Model.Name" />

        </div>

        <div class="details-info">

            <span class="details-category">
                @Model.Categories?.Name
            </span>

            <h1>@Model.Name</h1>

            <div class="details-price">
                @Model.Price €
            </div>

            <p class="details-description">
                @Model.Description
            </p>

            <div class="details-grid">

                <div class="info-box">
                    <span>Размер</span>
                    <strong>@Model.Size</strong>
                </div>

                <div class="info-box">
                    <span>Количество</span>
                    <strong>@Model.Quantity</strong>
                </div>

                <div class="info-box">
                    <span>Подходящо за</span>
                    <strong>@Model.Apply</strong>
                </div>

            </div>

            <div class="details-buttons">
                @if (User.IsInRole("User"))
                {
                    <a class="buy-btn-modern" asp-controller="Orders" asp-action="CreateById" asp-route-productId="@Model.Id">
                        🛒 Купи сега
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a class="edit-btn-modern" asp-action="Edit" asp-route-id="@Model?.Id">
                        ✏️ Редактирай
                    </a>
                    <a class="delete-btn-modern" asp-action="Delete" asp-route-id="@Model?.Id">
                        Изтрий
                    </a>
                }

            </div>

        </div>

    </div>

</div>
