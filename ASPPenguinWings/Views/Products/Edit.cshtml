
@model ASPPenguinWings.Models.Product

@{
    ViewData["Title"] = "Редактиране";
}

<div class="edit-page">

    <div class="edit-card">

        <div class="edit-image-side">

            <img src="@Model.ImageUrl" alt="@Model.Name" />

            <div class="image-overlay">
                <h2>Редактирай продукт 🛒</h2>
                <p>Промени информацията за продукта бързо и лесно.</p>
            </div>

        </div>

        <div class="edit-form-side">

            <h1>✏️ Редактиране</h1>

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="modern-form-group">
                    <label>Име</label>
                    <input asp-for="Name" class="form-control modern-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Категория</label>
                    <select asp-for="CategoryId"
                            class="form-control modern-input"
                            asp-items="ViewBag.CategoryId">
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Размер</label>
                    <input asp-for="Size" class="form-control modern-input" />
                    <span asp-validation-for="Size" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Количество</label>
                    <input asp-for="Quantity" class="form-control modern-input" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Описание</label>
                    <textarea asp-for="Description"
                              class="form-control modern-input modern-textarea">
                    </textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Подходящо за</label>
                    <input asp-for="Apply" class="form-control modern-input" />
                    <span asp-validation-for="Apply" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Снимка URL</label>
                    <input asp-for="ImageUrl" class="form-control modern-input" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="modern-form-group">
                    <label>Цена</label>
                    <input asp-for="Price" class="form-control modern-input" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="edit-buttons">

                    <button type="submit" class="save-btn-modern">
                        💾 Запази
                    </button>

                    <a asp-action="Index" class="back-btn-modern">
                        ← Назад
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
