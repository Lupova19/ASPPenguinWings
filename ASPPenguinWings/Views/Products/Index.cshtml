
@model IEnumerable<ASPPenguinWings.Models.Product>

@{
    ViewData["Title"] = "Продукти";
}

<div class="products-page">

    <!-- TOP -->
    <div class="products-top">

        <div>
            <span class="products-label">
                🐾 Крилете на пингвина
            </span>

            <h1>Нашите продукти</h1>

            <p>
                Избери най-доброто за своя любимец ✨
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="add-product-btn">
                ➕ Добави продукт
            </a>
        }

    </div>

    <!-- PRODUCTS -->
    <div class="modern-products-grid">

        @foreach (var item in Model)
        {
            <div class="modern-product-card">

                <!-- IMAGE -->
                <div class="product-image-wrapper">

                    <img src="@item.ImageUrl" alt="@item.Name" />

                    <div class="product-category">
                        @item.Categories?.Name
                    </div>

                </div>

                <!-- CONTENT -->
                <div class="product-card-content">

                    <h3>@item.Name</h3>

                    <p class="product-short-desc">
                        @item.Description
                    </p>

                    <!-- PRICE -->
                    <div class="modern-price">
                        @item.Price лв.
                    </div>
                    @if (item.Quantity > 0)
                    {
                        <p class="stock in-stock">
                            ✔ Налични: @item.Quantity бр.
                        </p>
                    }
                    else
                    {
                        <p class="stock out-stock">
                            ❌ Изчерпан продукт
                        </p>
                    }

                    <!-- BUTTONS -->
                    <div class="modern-actions">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="details-modern-btn">

                            👁 <br /> Виж
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="edit-modern-btn">

                                ✏️ Редактирай
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="delete-modern-btn">

                                🗑 Изтрий
                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>
