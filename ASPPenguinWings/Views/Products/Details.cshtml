@model ASPPenguinWings.Models.Product

@{
    ViewData["Title"] = "Детайли за продукт";
}

<h1>Details</h1>

<div class="product-details">

    <!-- Снимка -->
    <div class="product-image">
        <img src="@Model.ImageUrl" alt="@Model.Name" />
    </div>

     <!-- Информация --> 
    <div class="product-info">
        <h2>@Model.Name</h2>

        <p class="price">@Model.Price лв.</p>

        <p><strong>Категория:</strong> @Model.Categories?.Name</p>
        <p><strong>Размер:</strong> @Model.Size</p>
        <p><strong>Количество:</strong> @Model.Quantity</p>
        <p><strong>За:</strong> @Model.Apply</p>
        <p><strong>Описание:</strong> @Model.Description</p>

        <a class="buy-btn" asp-controller="Orders" asp-action="CreateById" asp-route-productId="@Model.Id" formmethod="get">Купи</a>
    </div>

</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Редактирай</a>
    }
    <a asp-action="Index" class="my-button">Обратно към продуктите</a>

</div>
