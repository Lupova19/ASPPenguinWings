@model IEnumerable<ASPPenguinWings.Models.Order>

@{
    ViewData["Title"] = "Моята количка";
}

@if (TempData["Message"] != null)
{
    <div class="cart-alert">
        @TempData["Message"]
    </div>
}

<div class="cart-page">

    <h1 class="cart-title">🛒 Моята количка</h1>

    @if (!Model.Any())
    {
        <div class="empty-cart">
            <h3>Количката е празна</h3>
            <p>Добави продукти и се върни тук 🐾</p>
        </div>
    }
    else
    {
        <div class="cart-grid">

            @foreach (var item in Model)
            {
                <div class="cart-card">

                    <div class="cart-image">
                        <img src="@item.Products.ImageUrl" alt="@item.Products.Name" />
                    </div>

                    <div class="cart-info">

                        <h3>@item.Products.Name</h3>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="customer-name">
                                👤 @item.Customers.UserName
                            </div>
                        }

                        <div class="cart-price">
                            @item.Products.Price €
                        </div>

                        <div class="quantity-box">

                            @if (!User.IsInRole("Admin"))
                            {
                                <a asp-action="Decrease"
                                   asp-route-id="@item.Id"
                                   class="qty-btn">
                                    −
                                </a>
                            }

                            <span>@item.Quantity бр.</span>

                            @if (!User.IsInRole("Admin"))
                            {
                                <a asp-action="Increase"
                                   asp-route-id="@item.Id"
                                   class="qty-btn">
                                    +
                                </a>
                            }

                        </div>

                        <div class="product-total">
                            Общо:
                            <strong>
                                @(item.Products.Price* item.Quantity) €
                            </strong>
                        </div>

                    </div>

                    <div class="cart-actions">

                        @if (!User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="remove-btn">
                                ✖ Премахни
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Complete"
                               asp-route-id="@item.Id"
                               class="complete-btn">
                                ✔ Завърши
                            </a>
                        }

                    </div>

                </div>
            }

        </div>

        <div class="checkout-section">

            <h2>
                Обща сума:
                <span>
                    @Model.Sum(x => x.Products.Price * x.Quantity) €
                </span>
            </h2>

            @if (User.IsInRole("User"))
            {
                <a asp-action="Checkout" class="checkout-btn">
                    💳 Завърши поръчката
                </a>
            }
        </div>
    }
</div>