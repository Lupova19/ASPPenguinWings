@model IEnumerable<ASPPenguinWings.Models.Order>

@{
    ViewData["Title"] = "Index";
}
@* jijk *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}
<h1>Index</h1>


<h2>Моята количка 🛒</h2>

@if (!Model.Any())
{
    <p>Нямате добавени продукти.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Продукт</th>
                <th>Цена</th>
                <th>Количество</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Products.Name</td>
                    <td>@item.Products.Price лв.</td>
                    <td>
                        <a asp-action="Decrease" asp-route-id="@item.Id">➖</a>
                        @item.Quantity
                        <a asp-action="Increase" asp-route-id="@item.Id">➕</a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                            Премахни
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Complete" asp-route-id="@item.Id" class="btn btn-success">
                                Завърши поръчка
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>
        Общо: @Model.Sum(x => x.Products.Price * x.Quantity) лв.
    </h4>

    @if (User.IsInRole("User"))
    {
        <a asp-action="Checkout" class="btn btn-success">
            💳 Завърши поръчка
        </a>
    }
    @* @if (Model.Any())
    {
        <a asp-action="Checkout" class="btn btn-success">
            💳 Завърши поръчка
        </a>
    } *@
    
}
